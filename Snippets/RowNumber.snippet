<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
<_locDefinition xmlns="urn:locstudio">
    <_locDefault _loc="locNone" />
    <_locTag _loc="locData">Title</_locTag>
    <_locTag _loc="locData">Description</_locTag>
    <_locTag _loc="locData">Author</_locTag>
    <_locTag _loc="locData">ToolTip</_locTag>
	<_locTag _loc="locData">Default</_locTag>
</_locDefinition>
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>RowNumber</Title>
			<Shortcut>RowNumber</Shortcut>
			<Description>Row_Number() OVER(Partition BY..</Description>
			<Author>David Smith</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="SQL"><![CDATA[ROW_NUMBER() OVER(PARTITION BY partitionByField ORDER BY orderByField) AS rowNumber]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
