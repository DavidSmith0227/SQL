	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>Temp_Insert</Title>
			<Shortcut>Temp_Insert</Shortcut>
			<Description>Format for allowing >2000 row insert</Description>
			<Author>David Smith</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="SQL"><![CDATA[CREATE TABLE #ImpactList (ID INT, strField VARCHAR(200))
/*
add or remove extra fields as necessary
*/
INSERT INTO #ImpactList(ID, strField)
SELECT ID, strField
FROM 
	(VALUES

		--('10197', 'cat'),
		--('10197', 'cat2')
	)
as sub (ID, strField);]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
